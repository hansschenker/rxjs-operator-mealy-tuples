{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true, "noEmit": true
  },
  "include": ["model/**/*.ts"]
}
